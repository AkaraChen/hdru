## Owners: who retains computations and when they are disposed.
use std.function.FnMut
use pkg.keys.{Mutate, NoTrack, OwnerId, Scheduler, Scope, Track, Ui}
use pkg.graph.{graph, new_owner}

## Runs `body` under a fresh root owner with all three keys installed, and
## returns the owner so the caller can `dispose` it. Any other key `body`
## names is the caller's to provide.
pub fn root[$R](body: fn() -> void $ Ui + Track + Mutate + R) -> OwnerId $ R:
    owner := new_owner(.None)
    $.with(
        Ui=box(Scope { owner: owner, parent: 0 }),
        Track=box(NoTrack {}),
        Mutate=box(Scheduler { writes: 0 }),
    ):
        body()
    owner

## Runs `body` under a child of the current owner, keeping the current
## parent node. This is a component boundary: what `body` creates or
## provides is disposed with the child, and `provide` inside it shadows
## the outer value only for `body`. Like `column`, it threads the caller's
## other keys into `body`.
pub fn owned[$R](body: fn() -> void $ Ui + R) -> void $ Ui + R:
    ui := $.use(Ui)
    owner := new_owner(.Some(ui.owner()))
    parent := ui.parent()
    $.with(Ui=box(Scope { owner: owner, parent: parent })):
        body()

## Registers `action` to run when the current owner is disposed.
pub fn on_cleanup[F < 'static & FnMut() -> void](mut action: F) -> void $ Ui:
    owner := $.use(Ui).owner()
    erased := fn() -> void: action()
    graph().owners[owner].cleanups.push(erased)

## The current owner.
pub fn current_owner() -> OwnerId $ Ui:
    $.use(Ui).owner()
