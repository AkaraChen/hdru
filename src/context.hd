## Owner-tree context: a value an ancestor provides by key, found by any
## descendant. The value is boxed once; every reader shares it.
use std.inspect.Inspectable
use pkg.keys.{OwnerId, Ui}
use pkg.graph.graph

## Makes `value` available under `key` to the current owner's subtree.
pub fn provide[T < 'static & Inspectable](key: string, value: T) -> void $ Ui:
    owner := $.use(Ui).owner()
    graph().owners[owner].context[key] = box(value)

## Finds the nearest `key` provided by the current owner or an ancestor
## and returns a copy of it as a `T`, or `.None` when no ancestor provided
## it or it holds another type. To share state through context, provide
## a handle such as a `Signal`.
pub fn use_context[T < 'static & Inspectable](key: string) -> T? $ Ui:
    g := graph()
    let cursor: OwnerId? = .Some($.use(Ui).owner())
    let found: T? = .None
    while found.is_none():
        owner := match cursor:
            .Some(id) => id
            .None => break
        if !g.owners.contains_key(owner):
            break
        record := g.owners[owner]
        match record.context.get(key):
            .Some(value) =>
                found = value.downcast_ref::[T]().map(fn(hit): *hit)
            .None => pass
        cursor = record.parent
    found

## A value supplied to a subtree as a requirement key, so a component that
## needs one names it in its row, `$ Ui + Provided[Theme]`, and a missing
## provider is a compile error rather than `.None` at run time. One generic
## key serves every type; `Provided[Theme]` and `Provided[Locale]` are two
## keys.
pub trait Provided[T]:
    fn value(self) -> T

## The provider `given` installs.
pub struct Given[T]:
    pub value: T

impl[T] Provided[T] for Given[T]:
    fn value(self) -> T:
        self.value

## Runs `body` with `value` available as `Provided[T]`. Every key of the
## caller passes through, so `given` nests inside `column` and the other
## builders, and they inside it. A component that names the key cannot be
## mounted where nobody gave it; `mount`'s doc test shows the error.
pub fn given[T < 'static, $R](value: T, body: fn() -> void $ R + Provided[T]) -> void $ R:
    $.with(Provided[T]=box(Given { value: value })):
        body()

## The value the nearest `given` supplied for `T`.
pub fn use_given[T]() -> T $ Provided[T]:
    $.use(Provided[T]).value()
