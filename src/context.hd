## Owner-tree context: a value an ancestor provides by key, found by any
## descendant. The value is boxed once; every reader shares it.
use std.inspect.Inspectable
use pkg.keys.{OwnerId, Ui}
use pkg.graph.graph

## Makes `value` available under `key` to the current owner's subtree.
pub fn provide[T < 'static & Inspectable](key: string, value: T) -> void $ Ui:
    owner := $.use(Ui).owner()
    graph().owners[owner].context[key] = box(value)

## Finds the nearest `key` provided by the current owner or an ancestor
## and returns a copy of it as a `T`, or `.None` when no ancestor provided
## it or it holds another type. To share state through context, provide
## a handle such as a `Signal`.
pub fn use_context[T < 'static & Inspectable](key: string) -> T? $ Ui:
    g := graph()
    let cursor: OwnerId? = .Some($.use(Ui).owner())
    let found: T? = .None
    while found.is_none():
        owner := match cursor:
            .Some(id) => id
            .None => break
        if !g.owners.contains_key(owner):
            break
        record := g.owners[owner]
        match record.context.get(key):
            .Some(value) =>
                found = value.downcast_ref::[T]().map(fn(hit): *hit)
            .None => pass
        cursor = record.parent
    found
