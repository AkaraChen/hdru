use std.testing.assert_equal
use dep.ui.{Command, HandlerId, NodeId, PropValue, Resource, UiEvent, dispatch, mount, reset_for_test, run_ready, take_commands}
use pkg.{Problem, Report, Workbench, app, appended, label, line_numbers, preview_note, status_state, status_text}

fn problem(line: i32) -> Problem:
    Problem {
        id: 0,
        line: line,
        column: 5,
        end_line: line,
        end_column: 9,
        code: "unknown-name",
        severity: "error",
        message: "`nope` is not defined",
    }

fn failed() -> Report:
    Report { ok: false, problems: [problem(2)] }

fn clean() -> Report:
    Report { ok: true, problems: [] }

struct Bench:
    dark: bool
    saved: string
    bound: List[string]
    indented: List[bool]

impl Workbench for Bench:
    fn example(&mut self, name: string) -> string:
        "# $name\n"

    fn prefers_dark(&mut self) -> bool:
        self.dark

    fn set_dark(&mut self, dark: bool) -> void:
        self.saved = if dark: "dark" else: "light"

    fn check!(&mut self, source: string) -> Report:
        clean()

    fn run!(&mut self, source: string) -> Report:
        clean()

    fn stop(&mut self) -> void:
        pass

    fn reveal(&mut self, problem: Problem) -> void:
        pass

    fn bind(&mut self, role: string, node: usize) -> void:
        self.bound.push(role)

    fn indent(&mut self, outdent: bool) -> void:
        self.indented.push(outdent)

fn listener(commands: List[Command], name: string) -> HandlerId:
    for command in commands:
        match command:
            .Listen(_, event, handler) =>
                if event == name:
                    return handler
            _ => pass
    panic("no listener for $name")

it("a problem's label names its place and code"):
    assert_equal(label(problem(2)), "2:5 unknown-name: `nope` is not defined", reason="placed")

it("a problem with no place or code labels only its message"):
    let mut p = problem(0)
    p.code = ""
    assert_equal(label(p), "`nope` is not defined", reason="no place")

it("the status counts problems"):
    assert_equal(status_text(.None), "Checking…", reason="nothing yet")
    assert_equal(status_text(.Some(clean())), "No errors", reason="clean")
    assert_equal(status_text(.Some(failed())), "1 problem", reason="one")
    assert_equal(status_state(.None), "checking", reason="state, nothing yet")
    assert_equal(status_state(.Some(clean())), "ok", reason="state, clean")
    assert_equal(status_state(.Some(failed())), "problems", reason="state, failed")

it("the preview says why nothing shows"):
    let loading: Resource[Report, string] = .Loading
    assert_equal(preview_note(loading, .None), "Compiling…", reason="compiling")
    assert_equal(preview_note(.Ready(failed()), .Some(failed())), "Not run: fix the problems first.", reason="still broken")
    assert_equal(preview_note(.Ready(failed()), .Some(clean())), "Press Run to try again.", reason="fixed")
    assert_equal(preview_note(.Ready(clean()), .Some(failed())), "Stopped. Press Run to start again.", reason="ran")

it("the gutter numbers every line, with the one after a final newline"):
    assert_equal(line_numbers(""), "1", reason="empty")
    assert_equal(line_numbers("a\nb\n"), "1\n2\n3", reason="trailing newline")

it("the log drops its oldest lines past the limit, at a line"):
    long := "x".repeat(15000)
    two := appended(appended("", "first $long"), "second $long")
    assert_equal(two, "second $long\n", reason="oldest line gone")

it("a system theme change only restyles"):
    reset_for_test()
    $.with(Workbench=box(Bench { dark: false, saved: "", bound: [], indented: [] })):
        _ := mount(app)
    commands := take_commands()
    dispatch(UiEvent { handler: listener(commands, "dom:theme-change"), payload: "dark" })
    changes := take_commands()
    assert_equal(changes.is_empty(), false, reason="something restyled")
    for change in changes:
        match change:
            .SetProp(_, _, _) => pass
            _ => panic("not only a restyle")

# The handler of `event` on the node whose attribute `name` is first `value`.
fn handler_of(commands: List[Command], name: string, value: string, event: string) -> HandlerId:
    # Node 0 is the root, which no attribute is set on.
    let mut found: NodeId = 0
    for command in commands:
        match command:
            .SetProp(node, key, v) =>
                if found == 0 && key == "dom:attr:$name" && v == PropValue.Text(value):
                    found = node
            _ => pass
    for command in commands:
        match command:
            .Listen(node, e, handler) =>
                if e == event && node == found:
                    return handler
            _ => pass
    panic("no $event handler on the node whose $name is $value")

# The handler of `event` on the node of `kind`.
fn handler_on_kind(commands: List[Command], kind: string, event: string) -> HandlerId:
    let mut found: NodeId = 0
    for command in commands:
        match command:
            .Create(node, k) =>
                if k == kind:
                    found = node
            _ => pass
    for command in commands:
        match command:
            .Listen(node, e, handler) =>
                if e == event && node == found:
                    return handler
            _ => pass
    panic("no $event handler on a $kind")

it("Tab indents through the host, and Escape gives Tab back to the browser"):
    reset_for_test()
    bench := box(Bench { dark: false, saved: "", bound: [], indented: [] })
    $.with(Workbench=bench):
        _ := mount(app)
    commands := take_commands()
    assert_equal(has_prop(commands, "take_keys", "Tab\nShift+Tab"), true, reason="the editor takes Tab")
    key := handler_on_kind(commands, "dom:textarea", "key")
    press := fn(name: string) -> void: dispatch(UiEvent { handler: key, payload: name })
    press("Tab")
    press("Shift+Tab")
    press("a")
    assert_equal(bench.indented, [false, true], reason="indent, outdent, and nothing for a letter")
    _ := take_commands()
    press("Escape")
    assert_equal(has_prop(take_commands(), "take_keys", ""), true, reason="the keys are given back")
    press("Shift")
    assert_equal(take_commands().is_empty(), true, reason="a modifier alone changes nothing")
    press("Tab")
    assert_equal(bench.indented.len(), 2, reason="the browser moved the focus; no indent")
    assert_equal(has_prop(take_commands(), "take_keys", "Tab\nShift+Tab"), true, reason="taken again")

fn has_prop(commands: List[Command], name: string, value: string) -> bool:
    for command in commands:
        match command:
            .SetProp(_, key, v) =>
                if key == name && v == PropValue.Text(value):
                    return true
            _ => pass
    false

it("every role is bound once the shell has been applied"):
    reset_for_test()
    bench := box(Bench { dark: false, saved: "", bound: [], indented: [] })
    $.with(Workbench=bench):
        _ := mount(app)
    assert_equal(bench.bound.is_empty(), true, reason="not while mounting")
    run_ready()
    for role in ["shell", "editor-gutter", "editor-back", "editor-input", "preview", "commands"]:
        assert_equal(bench.bound.contains(role), true, reason=role)

it("the theme button saves the choice and only restyles"):
    reset_for_test()
    bench := box(Bench { dark: false, saved: "", bound: [], indented: [] })
    $.with(Workbench=bench):
        _ := mount(app)
    commands := take_commands()
    dispatch(UiEvent { handler: handler_of(commands, "aria-label", "Switch to dark theme", "click"), payload: "" })
    assert_equal(bench.saved, "dark", reason="saved")
    changes := take_commands()
    assert_equal(changes.is_empty(), false, reason="something restyled")
    for change in changes:
        match change:
            .SetProp(_, _, _) => pass
            _ => panic("not only a restyle")
    dispatch(UiEvent { handler: handler_of(commands, "aria-label", "Switch to dark theme", "click"), payload: "" })
    assert_equal(bench.saved, "light", reason="toggled back")
