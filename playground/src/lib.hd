## The playground: edit an hdru program, see its type errors as you type, run
## it beside the commands it sends. Written in hdru; the compiler and the
## preview are behind the `Workbench` host trait.
use std.function.Fn
use dep.ui.{
    Align,
    Mutate,
    Owner,
    NodeId,
    Palette,
    ReadSignal,
    Resource,
    Signal,
    Size,
    Style,
    Target,
    Theme,
    Track,
    Ui,
    button,
    column,
    for_each,
    memo,
    on,
    on_ready,
    provide_theme,
    resource,
    rgb,
    row,
    show,
    signal,
    style_live,
    take_keys,
    text,
    view,
}
use dep.ui_dom.{DomStyle, attr, dom_on, link, textarea}
pub use pkg.workbench.{Problem, Report, Workbench}

# The most command log text kept, in characters.
LOG_LIMIT := 20000

REPOSITORY := "https://github.com/Eric-Song-Nop/hdru"

EXAMPLES := ["counter", "todos", "fetcher", "type-error"]

# The latest report, shown until a newer one lands, so nothing blinks on each
# keystroke.
struct Held:
    report: Report?

# The surfaces of hd-lang's "Orbit" design (website/assets/style.css).
fn palette_of(dark: bool) -> Palette:
    if dark:
        Palette {
            background: rgb(11, 15, 20),
            surface: rgb(15, 21, 28),
            on_surface: rgb(219, 230, 232),
            muted: rgb(141, 158, 165),
            line: rgb(26, 35, 44),
            accent: rgb(46, 230, 212),
            on_accent: rgb(4, 33, 30),
        }
    else:
        Palette {
            background: rgb(247, 250, 250),
            surface: rgb(255, 255, 255),
            on_surface: rgb(24, 34, 43),
            muted: rgb(83, 99, 107),
            line: rgb(223, 232, 232),
            accent: rgb(28, 196, 182),
            on_accent: rgb(4, 33, 30),
        }

## What a problem's row says.
pub fn label(p: Problem) -> string:
    place := if p.line > 0: "${p.line}:${p.column} " else: ""
    code := if p.code == "": "" else: "${p.code}: "
    "$place$code${p.message}"

## What the status chip says about the latest report.
pub fn status_text(latest: Report?) -> string:
    match latest:
        .None => "Checking…"
        .Some(report) =>
            count := report.problems.len()
            if count == 0:
                "No errors"
            else if count == 1:
                "1 problem"
            else:
                "$count problems"

## The status chip's state, which its stylesheet colors.
pub fn status_state(latest: Report?) -> string:
    match latest:
        .None => "checking"
        .Some(report) =>
            if report.problems.is_empty(): "ok" else: "problems"

## What the preview says when no program is showing.
pub fn preview_note(ran: Resource[Report, string], latest: Report?) -> string:
    match ran:
        .Loading => "Compiling…"
        .Failed(why) => "Run failed: $why"
        .Ready(report) =>
            if report.ok:
                return "Stopped. Press Run to start again."
            match latest:
                .Some(now) =>
                    if now.ok: "Press Run to try again." else: "Not run: fix the problems first."
                .None => "Not run: fix the problems first."

## The editor's gutter for `source`: one number per line.
pub fn line_numbers(source: string) -> string:
    let mut out = "1"
    for n in 2..(source.split("\n").len() + 1):
        out = "$out\n$n"
    out

## `log` with `more` added, its oldest text cut past the limit.
pub fn appended(log: string, more: string) -> string:
    next := log + more + "\n"
    if next.len() <= LOG_LIMIT:
        return next
    # Cut at a line, so the panel never starts mid-character or mid-line.
    let mut lines = next.split("\n")
    while lines.len() > 1 && lines.join("\n").len() > LOG_LIMIT:
        _ := lines.remove_at(0)
    lines.join("\n")

# The keys the editor takes from the browser. After Escape it takes none, so that
# Tab can leave the editor and the keyboard is never trapped in it.
fn editor_keys(leaving: bool) -> List[string]:
    if leaving: [] else: ["Tab", "Shift+Tab"]

## Whether the editor gives its keys back, after `key` from `now`: Escape asks for
## it, a modifier alone changes nothing, and any other key ends it.
pub fn leaving_after(key: string, now: bool) -> bool:
    if key == "Escape":
        return true
    if ["Shift", "Control", "Alt", "Meta"].contains(key):
        return now
    false

# Binds the block's node to `role`, for the host to find.
fn bound(bench: *mut dyn Workbench, role: string) -> void $ Owner + Target:
    on_ready(fn(node: NodeId) -> void $ Mutate: bench.bind(role, node))

fn pressed(on: bool) -> string:
    if on: "true" else: "false"

fn theme_label(dark: bool) -> string:
    if dark: "Switch to light theme" else: "Switch to dark theme"

# A panel's title bar, with a live note at its end.
fn panel_head[F < 'static & Fn() -> string $ Track](title: string, note: F) -> void $ Ui:
    row(style=Style::empty().align(.Center).gap(8.0).dom_class("panel-head")):
        view(style=Style::empty().dom_class("panel-title")):
            text(fn(): title)
        view(style=Style::empty().grow(1.0)):
            pass
        view(style=Style::empty().dom_class("panel-note")):
            text(note)

# One problem. A row is keyed by its position, so the rows a list can ever hold
# are as many as its longest report, however long the session.
fn problem_row(item: ReadSignal[Problem], bench: *mut dyn Workbench) -> void $ Ui:
    view(style=Style::empty().dom_class("problem")):
        attr("data-severity", fn(): item.get().severity)
        attr("role", fn(): "button")
        attr("tabindex", fn(): "0")
        on("click", fn(payload: string) -> void $ Mutate: bench.reveal(item.peek()))
        on("enter", fn(payload: string) -> void $ Mutate: bench.reveal(item.peek()))
        text:
            label(item.get())

# What a theme choice writes. Colors that follow it are in `style_live`s, and
# hover and focus colors are the stylesheet's, which the host keeps in step.
fn apply_theme(dark: Signal[bool], palette: Signal[Palette], next: bool) -> void $ Mutate:
    dark.set(next)
    palette.set(palette_of(next))

fn shell(bench: *mut dyn Workbench, dark: Signal[bool], palette: Signal[Palette]) -> void $ Ui + Theme:
    theme := $.use(Theme).palette()
    current := signal("counter")
    source := signal(bench.example("counter"))
    runs := signal(+0)
    log := signal("")
    checked := resource(
        fn(): source.get(),
        fn!(text: string) -> Result[Report, string]:
            .Ok(bench.check!(text))
        ,
    )
    # A run reads the source when it starts, so typing does not start one.
    ran := resource(
        fn(): runs.get(),
        fn!(key: i32) -> Result[Report, string]:
            .Ok(bench.run!(source.peek()))
        ,
    )
    held := box(Held { report: .None })
    latest := memo:
        match checked.get():
            .Ready(report) => held.report = .Some(report)
            _ => pass
        held.report
    problems := memo:
        match latest.get():
            .Some(report) => report.problems
            .None => []
    numbers := memo:
        line_numbers(source.get())
    start := fn() -> void $ Mutate:
        log.set("")
        runs.update(fn(n): n + 1)
    leaving := signal(false)
    column(style=Style::empty().height(.Pct(100.0))):
        bound(bench, "shell")
        dom_on(
            "theme-change",
            fn(scheme: string) -> void $ Mutate:
                apply_theme(dark, palette, scheme == "dark")
            ,
        )
        style_live:
            p := theme.get()
            Style::empty().bg(p.background).color(p.on_surface)
        row(style=Style::empty().gap(8.0).align(.Center).wrap(true).dom_class("topbar")):
            view(style=Style::empty().dom_class("brand-mark")):
                pass
            view(style=Style::empty().dom_class("brand")):
                text(fn(): "hdru")
            view(style=Style::empty().dom_class("brand-sub")):
                text(fn(): "playground")
            button(fn(): start(), style=Style::empty().dom_class("btn btn-primary")):
                text(fn(): "Run")
            button(fn(): bench.stop(), style=Style::empty().dom_class("btn")):
                text(fn(): "Stop")
            row(style=Style::empty().dom_class("tabs")):
                for name in EXAMPLES:
                    button(
                        fn():
                            current.set(name)
                            source.set(bench.example(name))
                            start()
                        ,
                        style=Style::empty().dom_class("tab"),
                    ):
                        attr("aria-pressed", fn(): pressed(current.get() == name))
                        text(fn(): name)
            view(style=Style::empty().grow(1.0)):
                pass
            view(style=Style::empty().dom_class("status")):
                attr("data-state", fn(): status_state(latest.get()))
                text:
                    status_text(latest.get())
            button(
                fn():
                    next := !dark.peek()
                    bench.set_dark(next)
                    apply_theme(dark, palette, next)
                ,
                style=Style::empty().dom_class("btn btn-icon theme-toggle"),
            ):
                attr("aria-label", fn(): theme_label(dark.get()))
                attr("title", fn(): theme_label(dark.get()))
            link(REPOSITORY, style=Style::empty().dom_class("btn btn-icon github-link")):
                attr("aria-label", fn(): "hdru on GitHub")
                attr("title", fn(): "hdru on GitHub")
        row(style=Style::empty().grow(1.0).min_height(.Px(0.0)).dom_class("workspace")):
            column(style=Style::empty().grow(1.0).width(.Pct(50.0)).min_height(.Px(0.0)).dom_class("half half-left")):
                # The field on top edits; the same text behind it shows the
                # colors and the problems (web/playground/editor.mjs).
                view(style=Style::empty().grow(1.0).height(.Px(0.0)).dom_class("editor")):
                    style_live:
                        Style::empty().bg(theme.get().surface)
                    view(style=Style::empty().font_size(13.0).dom_class("editor-gutter")):
                        bound(bench, "editor-gutter")
                        text:
                            numbers.get()
                    view(style=Style::empty().padding(12.0).font_size(13.0).dom_class("editor-back")):
                        bound(bench, "editor-back")
                        text:
                            source.get()
                    textarea(source, style=Style::empty().padding(12.0).font_size(13.0).dom_class("editor-input")):
                        bound(bench, "editor-input")
                        take_keys(fn(): editor_keys(leaving.get()))
                        on(
                            "key",
                            fn(key: string) -> void $ Mutate:
                                # A taken Tab: with the keys given back, the browser has moved the focus.
                                if !leaving.peek():
                                    if key == "Tab":
                                        bench.indent(false)
                                    else if key == "Shift+Tab":
                                        bench.indent(true)
                                leaving.update(fn(now): leaving_after(key, now))
                            ,
                        )
                view(style=Style::empty().dom_class("dock")):
                    panel_head("Problems", fn(): "${problems.get().len()}")
                    view(style=Style::empty().max_height(.Px(160.0)).dom_class("pane")):
                        show(fn(): problems.get().is_empty()):
                            view(style=Style::empty().dom_class("empty")):
                                text(fn(): "Nothing to fix.")
                        for_each(problems, fn(p): p.id, fn(item): problem_row(item, bench))
            column(style=Style::empty().grow(1.0).width(.Pct(50.0)).min_height(.Px(0.0)).dom_class("half")):
                panel_head("Preview", fn(): "sandboxed")
                view(style=Style::empty().grow(1.0).height(.Px(0.0)).dom_class("stage")):
                    style_live:
                        Style::empty().bg(theme.get().surface)
                    view(style=Style::empty().dom_class("stage-note")):
                        text:
                            preview_note(ran.get(), latest.get())
                    view(style=Style::empty().dom_class("stage-frame")):
                        bound(bench, "preview")
                panel_head("Commands", fn(): "what the UI sends its renderer")
                view(style=Style::empty().grow(1.0).height(.Px(0.0)).dom_class("pane log")):
                    bound(bench, "commands")
                    dom_on("preview-log", fn(more: string) -> void $ Mutate: log.update(fn(now): appended(now, more)))
                    text:
                        log.get()

## The playground.
pub fn app() -> void $ Ui + Workbench:
    let bench: *mut dyn Workbench = $.use(Workbench)
    starts_dark := bench.prefers_dark()
    dark := signal(starts_dark)
    palette := signal(palette_of(starts_dark))
    provide_theme(palette):
        shell(bench, dark, palette)
