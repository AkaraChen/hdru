use dep.ui.{Command, PropValue, Style, Ui, UiEvent, column, dispatch, input, mount, reset_for_test, signal, take_commands, text}
use pkg.{DomStyle, attr, attr_live, dom_on, textarea}
use std.testing.assert_equal

it("dom_class lowers to the dom:class key"):
    reset_for_test()
    _ := mount(fn() -> void $ Ui: text("hi", style=Style::empty().font_size(18.0).dom_class("lead")))
    commands := take_commands()
    assert_equal(commands.contains(.SetProp(1, "dom:class", .Text("lead"))), true, reason="the class")
    assert_equal(commands.contains(.SetProp(1, "font_size", .Number(18.0))), true, reason="beside a portable key")

it("attr and attr_live lower to dom:attr keys on the last node"):
    reset_for_test()
    level := signal("low")
    _ := mount(
        fn() -> void $ Ui:
            column:
                text("first")
                attr("title", "first")
                attr_live("data-level", fn(): level.get())
            attr("id", "main")
        ,
    )
    commands := take_commands()
    assert_equal(commands.contains(.SetProp(2, "dom:attr:title", .Text("first"))), true, reason="the text, from inside")
    assert_equal(commands.contains(.SetProp(1, "dom:attr:id", .Text("main"))), true, reason="the column, after its block")
    assert_equal(commands.contains(.SetProp(2, "dom:attr:data-level", .Text("low"))), true, reason="the first value")

it("textarea is a field of the dom:textarea kind, bound as input is"):
    reset_for_test()
    draft := signal("a")
    _ := mount(fn() -> void $ Ui: textarea(draft))
    commands := take_commands()
    assert_equal(commands.get(0).copied(), .Some(Command.Create(1, "dom:textarea")), reason="its kind")
    assert_equal(commands.contains(.SetProp(1, "value", .Text("a"))), true, reason="its value")
    dispatch(UiEvent { handler: 1, payload: "ab" })
    assert_equal(draft.peek(), "ab", reason="typing writes the signal")
    assert_equal(take_commands(), [], reason="and is not echoed")

it("dom_on listens under the dom: prefix, and input under a portable name"):
    reset_for_test()
    seen := signal("")
    draft := signal("")
    _ := mount(
        fn() -> void $ Ui:
            input(draft)
            dom_on("focus", fn(payload: string): seen.set(payload))
        ,
    )
    commands := take_commands()
    assert_equal(commands.contains(.Listen(1, "input", 1)), true, reason="portable")
    assert_equal(commands.contains(.Listen(1, "dom:focus", 2)), true, reason="the DOM's own")
    dispatch(UiEvent { handler: 2, payload: "x" })
    assert_equal(seen.peek(), "x", reason="the handler ran")
