## The words only the DOM has. Each lowers to a `dom:` key, kind or event, which
## other renderers ignore, so code that reaches past the portable vocabulary
## shows it in its imports (`rendering.md`).
use std.function.{Fn, FnMut}
use dep.ui.{Mutate, PropValue, Signal, Style, Track, Ui, container, on, prop, text_field}

## `dom_class`, as a chain method on `ui`'s `Style`.
pub trait DomStyle:
    ## Sets the element's `class` attribute.
    fn dom_class(self, value: string) -> Style

impl DomStyle for Style:
    fn dom_class(self, value: string) -> Style:
        self.host_prop("dom:class", .Text(value))

## A DOM attribute of `last_node()` that follows the signals `value` reads: on a
## container once its block has run, or from inside the block on the child built
## last.
##
## ```hd
## use dep.ui.{Ui, column, text}
## use pkg.attr
## fn page() -> void $ Ui:
##     column:
##         text(fn(): "hi")
##         attr("title", fn(): "greeting")
##     attr("id", fn(): "main")
## ```
pub fn attr[F < 'static & Fn() -> string $ Track](name: string, value: F) -> void $ Ui:
    prop("dom:attr:$name", fn() -> PropValue $ Track: .Text(value()))

## Calls `handler` when the DOM event `event` fires on `last_node()`. The
## payload is a `CustomEvent`'s string `detail`, else the target's value.
pub fn dom_on[F < 'static & FnMut(string) -> void $ Mutate](event: string, mut handler: F) -> void $ Ui:
    on("dom:$event", fn(payload: string) -> void $ Mutate: handler(payload))

## A link to `href`, holding what its block builds. It opens in a new tab, and
## `last_node()` names it afterwards, so `attr` can label it.
pub fn link[$R](href: string, style: Style = Style::empty(), children: fn() -> void $ Ui + R) -> void $ Ui + R:
    container("dom:a", style, children)
    attr("href", fn(): href)
    attr("target", fn(): "_blank")
    attr("rel", fn(): "noopener noreferrer")

## A multi-line text field bound to `value`, as `ui`'s `input` is.
pub fn textarea(value: Signal[string], style: Style = Style::empty()) -> void $ Ui:
    text_field("dom:textarea", value, style)
