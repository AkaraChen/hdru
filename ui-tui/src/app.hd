## `run_app!` on this renderer's host: adapts `Surface` to `ui`'s `Renderer`.
use dep.ui.{Command, Renderer, Ui, UiEvent, run_on}
use pkg.surface.Surface

struct Bridge:
    surface: *mut dyn Surface

impl Renderer for Bridge:
    fn apply!(&mut self, commands: List[Command]) -> void:
        self.surface.apply!(commands)

    fn next_event!(&mut self) -> UiEvent:
        self.surface.next_event!()

## Runs `root` on the host until it sends handler 0 (`ui`'s `run_on!`).
pub fn run_app![$ R](root: fn() -> void $ Ui + R) -> void $ Surface + R:
    let surface: *mut dyn Surface = $.use(Surface)
    $.with(Renderer=box(Bridge { surface: surface })):
        run_on!(root)
