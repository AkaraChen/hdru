use dep.ui.{Command, Ui, UiEvent, button, reset_for_test, signal, text}
use pkg.{Surface, run_app}
use std.testing.assert_equal

# The loop itself is tested in `ui`; this is the adapter from the host trait.
struct Host:
    log: List[Command]
    events: List[UiEvent]

impl Surface for Host:
    fn apply!(&mut self, commands: List[Command]) -> void:
        for command in commands:
            self.log.push(command)

    fn next_event!(&mut self) -> UiEvent:
        if self.events.is_empty():
            UiEvent { handler: 0, payload: "" }
        else:
            self.events.remove_at(0)

fn app() -> void $ Ui:
    label := signal("before")
    button(fn(): label.set("after")):
        text(fn(): "go")

it("run_app carries commands and events across the host trait, and stops on handler 0"):
    reset_for_test()
    host := box(Host { log: [], events: [UiEvent { handler: 1, payload: "" }] })
    $.with(Surface=host):
        run_app!(app)
    assert_equal(host.log.get(0), .Some(Command.Create(1, "button")), reason="mount reached the host")
    assert_equal(host.events.is_empty(), true, reason="the event was taken")
