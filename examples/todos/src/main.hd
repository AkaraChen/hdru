use dep.ui.{
    Mutate,
    ReadSignal,
    Signal,
    Ui,
    attr_live,
    button,
    column,
    for_each,
    input,
    memo,
    on,
    row,
    show,
    signal,
    text,
    text_live,
}
use dep.ui_dom.{Surface, run_app}

@derive(Eq)
struct Todo:
    id: usize
    title: string
    done: bool

fn toggle(id: usize, xs: List[Todo]) -> List[Todo]:
    [for todo in xs => if todo.id == id: Todo { ...todo, done: !todo.done } else: todo]

fn without(id: usize, xs: List[Todo]) -> List[Todo]:
    xs.filter(fn(todo): todo.id != id)

## Appends a todo titled `title` unless it is blank, and clears the draft.
fn add(todos: Signal[List[Todo]], next_id: Signal[usize], draft: Signal[string], title: string) -> void $ Mutate:
    trimmed := title.trim()
    if trimmed == "":
        return
    id := next_id.peek()
    next_id.set(id + 1)
    todos.update(fn(xs): [xs..., Todo { id: id, title: trimmed, done: false }])
    draft.set("")

fn todo_row(todos: Signal[List[Todo]], todo: ReadSignal[Todo]) -> void $ Ui:
    row(gap=8):
        text_live:
            if todo.get().done:
                "[x] ${todo.get().title}"
            else:
                "[ ] ${todo.get().title}"
        attr_live(
            "class",
            fn():
                if todo.get().done: "grow done" else: "grow"
            ,
        )
        button(
            "toggle",
            fn():
                todos.update(fn(xs): toggle(todo.peek().id, xs))
            ,
        )
        button(
            "remove",
            fn():
                todos.update(fn(xs): without(todo.peek().id, xs))
            ,
        )

fn app() -> void $ Ui:
    todos := signal(
        [
            Todo { id: 1, title: "write the core", done: true },
            Todo { id: 2, title: "write the builders", done: false },
            Todo { id: 3, title: "ship a browser demo", done: false },
        ],
    )
    next_id := signal::[usize](4)
    draft := signal("")
    remaining := memo:
        todos.get().filter(fn(todo): !todo.done).len()
    column(class="card", gap=8):
        text_live:
            "${remaining.get()} left"
        for_each(todos.read(), fn(todo): todo.id, fn(todo): todo_row(todos, todo))
        row(gap=8):
            input(draft, class="grow")
            on(
                "enter",
                fn(title: string) -> void $ Mutate:
                    add(todos, next_id, draft, title)
                ,
            )
            button(
                "add",
                fn():
                    add(todos, next_id, draft, draft.peek())
                ,
                class="primary",
            )
            button(
                "reverse",
                fn():
                    todos.update(fn(xs): xs.reversed())
                ,
            )
        show(fn(): remaining.get() == 0):
            text("all done", class="muted")

pub fn main!() -> void $ Surface:
    run_app!(app)
