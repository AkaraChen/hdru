use dep.ui.{
    Mutate,
    Palette,
    ReadSignal,
    Signal,
    Style,
    Theme,
    Ui,
    button,
    column,
    for_each,
    input,
    memo,
    on,
    provide_theme,
    rgba,
    row,
    show,
    signal,
    style_live,
    text,
    text_live,
    view,
}

## A button that reads on either palette.
fn quiet() -> Style:
    Style::empty().padding_x(10.0).padding_y(4.0).radius(6.0).border(1.0, rgba(128, 128, 128, 128)).bg(rgba(0, 0, 0, 0)).cursor(.Pointer)

@derive(Eq)
struct Todo:
    id: usize
    title: string
    done: bool

fn toggle(id: usize, xs: List[Todo]) -> List[Todo]:
    [for todo in xs => if todo.id == id: Todo { ...todo, done: !todo.done } else: todo]

fn without(id: usize, xs: List[Todo]) -> List[Todo]:
    xs.filter(fn(todo): todo.id != id)

## Appends a todo titled `title` unless it is blank, and clears the draft.
fn add(todos: Signal[List[Todo]], next_id: Signal[usize], draft: Signal[string], title: string) -> void $ Mutate:
    trimmed := title.trim()
    if trimmed == "":
        return
    id := next_id.peek()
    next_id.set(id + 1)
    todos.update(fn(xs): [xs..., Todo { id: id, title: trimmed, done: false }])
    draft.set("")

fn todo_row(todos: Signal[List[Todo]], todo: ReadSignal[Todo]) -> void $ Ui:
    row(style=Style::empty().gap(8.0).align(.Center)):
        # A done row fades: one key, restyled when the item changes.
        style_live:
            Style::empty().opacity(if todo.get().done: 0.5 else: 1.0)
        view(style=Style::empty().grow(1.0)):
            text_live:
                if todo.get().done:
                    "[x] ${todo.get().title}"
                else:
                    "[ ] ${todo.get().title}"
        button(
            "toggle",
            fn():
                todos.update(fn(xs): toggle(todo.peek().id, xs))
            ,
            style=quiet(),
        )
        button(
            "remove",
            fn():
                todos.update(fn(xs): without(todo.peek().id, xs))
            ,
            style=quiet(),
        )

fn list() -> void $ Ui + Theme:
    theme := $.use(Theme).palette()
    todos := signal(
        [
            Todo { id: 1, title: "write the core", done: true },
            Todo { id: 2, title: "write the builders", done: false },
            Todo { id: 3, title: "ship a browser demo", done: false },
        ],
    )
    next_id := signal::[usize](4)
    draft := signal("")
    remaining := memo:
        todos.get().filter(fn(todo): !todo.done).len()
    p := theme.peek()
    column(style=Style::empty().gap(8.0).padding(16.0).radius(8.0).border(1.0, p.line)):
        style_live:
            q := theme.get()
            Style::empty().bg(q.surface).color(q.on_surface).border_color(q.line)
        text_live:
            "${remaining.get()} left"
        for_each(todos.read(), fn(todo): todo.id, fn(todo): todo_row(todos, todo))
        row(style=Style::empty().gap(8.0)):
            input(draft, style=Style::empty().grow(1.0).padding_x(8.0).padding_y(4.0).radius(6.0).border(1.0, p.line))
            on(
                "enter",
                fn(title: string):
                    add(todos, next_id, draft, title)
                ,
            )
            button(
                "add",
                fn():
                    add(todos, next_id, draft, draft.peek())
                ,
                style=quiet().bg(p.accent).color(p.on_accent).border_color(p.accent),
            )
            button(
                "reverse",
                fn():
                    todos.update(fn(xs): xs.reversed())
                ,
                style=quiet(),
            )
        show(fn(): remaining.get() == 0):
            text("all done", style=Style::empty().color(p.muted))

## The app, for either renderer: its entries are `main.hd` and `tui.hd`.
pub fn app() -> void $ Ui:
    provide_theme(signal(Palette::light())):
        list()
