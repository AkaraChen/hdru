use dep.ui.{Ui, attr, button, column, row, signal, text_live}
use dep.ui_dom.{Surface, run_app}

fn counter() -> void $ Ui:
    count := signal(+0)
    column(class="card", gap=8):
        text_live:
            "Count: ${count.get()}"
        attr("class", "title")
        row(gap=4):
            button(
                "-",
                fn():
                    count.update(fn(n): n - 1)
                ,
            )
            button(
                "+",
                fn():
                    count.update(fn(n): n + 1)
                ,
            )

pub fn main!() -> void $ Surface:
    run_app!(counter)
