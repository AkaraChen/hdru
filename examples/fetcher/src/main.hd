use dep.ui.{Resource, Signal, Surface, Ui, attr, attr_live, button, column, resource, row, run_app, signal, text_live}
use std.time.{Clock, ms}

## Pretends to fetch a profile: waits, then answers, or fails for id 13.
fn fetch_profile!(clock: *mut dyn Clock, id: i32) -> Result[string, string]:
    clock.sleep!(ms(400))
    if id == 13: .Err("unlucky") else: .Ok("profile of user $id")

fn describe(state: Resource[string, string]) -> string:
    match state:
        .Loading => "loading…"
        .Ready(value) => value
        .Failed(error) => "failed: $error"

## The profile of the user `id` names. Its row says it needs a clock, and
## it reads one from inside the `column:` of `app`: a builder's block runs
## under its caller's whole row. The loader runs later on a worker, so it
## captures the clock lexically.
fn profile(id: Signal[i32]) -> void $ Ui + Clock:
    let clock: *mut dyn Clock = $.use(Clock)
    loaded := resource(
        fn(): id.get(),
        fn!(key: i32) -> Result[string, string]: fetch_profile!(clock, key)
        ,
    )
    text_live:
        describe(loaded.get())
    attr_live(
        "class",
        fn():
            match loaded.get():
                .Loading => "muted"
                .Ready(_) => ""
                .Failed(_) => "done"
        ,
    )

fn app() -> void $ Ui + Clock:
    id := signal(+1)
    column(class="card", gap=8):
        text_live:
            "user ${id.get()}"
        attr("class", "title")
        profile(id)
        row(gap=4):
            button(
                "previous",
                fn():
                    id.update(fn(n): n - 1)
                ,
            )
            button(
                "next",
                fn():
                    id.update(fn(n): n + 1)
                ,
            )
            button("unlucky", fn(): id.set(+13))

pub fn main!() -> void $ Surface + Clock:
    run_app!(app)
