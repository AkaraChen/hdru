use dep.ui.{
    Palette,
    Resource,
    Signal,
    Style,
    Ui,
    button,
    column,
    resource,
    rgb,
    rgba,
    row,
    signal,
    style_live,
    text_live,
    view,
}
use std.time.{Clock, ms}

## Pretends to fetch a profile: waits, then answers, or fails for id 13.
fn fetch_profile!(id: i32) -> Result[string, string] $ Clock:
    $.use(Clock).sleep!(ms(400))
    if id == 13: .Err("unlucky") else: .Ok("profile of user $id")

fn describe(state: Resource[string, string]) -> string:
    match state:
        .Loading => "loading…"
        .Ready(value) => value
        .Failed(error) => "failed: $error"

## The profile of the user `id` names. Its row says it needs a clock, and
## it reads one from inside the `column:` of `app`: a builder's block runs
## under its caller's whole row. The loader runs later on a worker, so it
## captures the clock lexically and installs it around `fetch_profile!`,
## whose own row stays honest.
fn profile(id: Signal[i32]) -> void $ Ui + Clock:
    let clock: *mut dyn Clock = $.use(Clock)
    loaded := resource(
        fn(): id.get(),
        fn!(key: i32) -> Result[string, string]:
            $.with(Clock=clock):
                fetch_profile!(key)
        ,
    )
    p := Palette::light()
    # The text's color follows the load: muted while loading, red on a
    # failure. On the DOM the text inherits it from this view.
    view:
        style_live:
            match loaded.get():
                .Loading => Style::empty().color(p.muted)
                .Ready(_) => Style::empty().color(p.on_surface)
                .Failed(_) => Style::empty().color(rgb(190, 40, 40))
        text_live:
            describe(loaded.get())

## A button that reads on either palette.
fn quiet() -> Style:
    Style::empty().padding_x(10.0).padding_y(4.0).radius(6.0).border(1.0, rgba(128, 128, 128, 128)).bg(rgba(0, 0, 0, 0)).cursor(.Pointer)

## The app, for either renderer: its entries are `main.hd` and `tui.hd`.
pub fn app() -> void $ Ui + Clock:
    p := Palette::light()
    id := signal(+1)
    column(style=Style::empty().gap(8.0).padding(16.0).radius(8.0).border(1.0, p.line).bg(p.surface)):
        view(style=Style::empty().font_size(18.0).font_weight(600.0)):
            text_live:
                "user ${id.get()}"
        profile(id)
        row(style=Style::empty().gap(4.0)):
            button(
                "previous",
                fn():
                    id.update(fn(n): n - 1)
                ,
                style=quiet(),
            )
            button(
                "next",
                fn():
                    id.update(fn(n): n + 1)
                ,
                style=quiet(),
            )
            button("unlucky", fn(): id.set(+13), style=quiet())
