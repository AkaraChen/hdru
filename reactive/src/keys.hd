## Identifiers and the three requirement keys of the reactive runtime.
##
## `Track` is required to read a signal, `Mutate` to write one, and `Owner`
## to create a computation. A function's row therefore says which phase it
## belongs to, and the checker rejects a write inside a memo. The `ui`
## package adds a `Parent` key and names `$ Owner + Parent` as `Ui`.

pub type SourceId = usize
pub type ComputationId = usize
pub type OwnerId = usize

## The row every stored computation body runs under: it may read signals
## tracked and write them.
pub type Reactive = $ Track + Mutate

## Installed around every tracked computation. `depend` records one source
## the running computation read.
pub trait Track:
    fn depend(&mut self, source: SourceId) -> void

## Installed where signals may be written. `invalidate` is told about each
## write; flushing is the graph's business, not the provider's.
pub trait Mutate:
    fn invalidate(&mut self, source: SourceId) -> void

## Installed wherever computations are created. `owner` names the owner
## that retains every computation, cleanup and context value created
## there, and is disposed with them.
pub trait Owner:
    fn owner(&self) -> OwnerId

## The `Track` provider the runtime installs around a computation.
pub struct Collector:
    pub deps: List[SourceId]

impl Track for Collector:
    fn depend(&mut self, source: SourceId) -> void:
        if !self.deps.contains(source):
            self.deps.push(source)

## A `Track` provider that records nothing: reads under it are untracked.
pub struct NoTrack: pass

impl Track for NoTrack:
    fn depend(&mut self, source: SourceId) -> void:
        pass

## The `Mutate` provider: counts writes, nothing more.
pub struct Scheduler:
    pub writes: usize

impl Mutate for Scheduler:
    fn invalidate(&mut self, source: SourceId) -> void:
        self.writes += 1

## A `Mutate` provider that records each source written, once, in order.
## `dispatch` installs one around every handler.
pub struct WriteLog:
    pub sources: List[SourceId]

impl Mutate for WriteLog:
    fn invalidate(&mut self, source: SourceId) -> void:
        if !self.sources.contains(source):
            self.sources.push(source)

## A `Mutate` provider that panics on any write, for `assert_no_writes`.
pub struct NoWrites: pass

impl Mutate for NoWrites:
    fn invalidate(&mut self, source: SourceId) -> void:
        panic("ui: signal $source was written inside assert_no_writes")

## The `Owner` provider `root` and `owned` install.
pub struct OwnedBy:
    pub owner: OwnerId

impl Owner for OwnedBy:
    fn owner(&self) -> OwnerId:
        self.owner
