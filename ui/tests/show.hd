use pkg.{
    Command,
    Ui,
    UiEvent,
    button,
    column,
    dispatch,
    mount,
    reset_for_test,
    show,
    signal,
    take_commands,
    text,
}
use std.testing.assert_equal

fn toggler() -> void $ Ui:
    visible := signal(true)
    outer := signal(+0)
    column:
        button(
            fn():
                visible.update(fn(v): !v)
            ,
        ):
            text(fn(): "toggle")
        button(
            fn():
                outer.update(fn(n): n + 1)
            ,
        ):
            text(fn(): "outer+")
        button(fn(): visible.set(true)):
            text(fn(): "force")
        show(fn(): visible.get()):
            inner := signal(+0)
            text:
                "Inner: ${inner.get()}"
            text:
                "Outer: ${outer.get()}"
            button(
                fn():
                    inner.update(fn(n): n + 1)
                ,
            ):
                text(fn(): "inner+")
        text(fn(): "after")

fn click(handler: usize) -> List[Command]:
    dispatch(UiEvent { handler: handler, payload: "" })
    take_commands()

it("show mounts its branch in place and keeps the node after it"):
    reset_for_test()
    _ := mount(toggler)
    commands := take_commands()
    assert_equal(commands.get(0).copied(), .Some(Command.Create(1, "box")), reason="column")
    assert_equal(commands.contains(.Create(8, "fragment")), true, reason="the fragment")
    assert_equal(commands.contains(.Append(8, 9)), true, reason="inner text under the fragment")
    assert_equal(commands.contains(.SetText(9, "Inner: 0")), true, reason="inner text")
    assert_equal(commands.contains(.SetText(10, "Outer: 0")), true, reason="outer text")
    assert_equal(commands.contains(.Listen(11, "click", 4)), true, reason="inner button")
    assert_equal(commands.contains(.Append(1, 13)), true, reason="the text after the fragment")
    assert_equal(commands.contains(.SetText(13, "after")), true, reason="after")

it("hiding disposes the branch: its state, its bindings and its handlers"):
    reset_for_test()
    _ := mount(toggler)
    _ := take_commands()
    assert_equal(click(4), [.SetText(9, "Inner: 1")], reason="inner+ updates the inner text")
    assert_equal(click(2), [.SetText(10, "Outer: 1")], reason="outer+ updates the outer text")
    assert_equal(click(3), [], reason="forcing visible to the same value does nothing")
    assert_equal(click(1), [.Clear(8)], reason="hide clears the fragment")
    assert_equal(click(4), [], reason="the inner handler is gone")
    assert_equal(click(2), [], reason="the outer binding inside the branch is gone")
    assert_equal(
        click(1),
        [
            .Create(14, "text"),
            .Append(8, 14),
            .SetText(14, "Inner: 0"),
            .Create(15, "text"),
            .Append(8, 15),
            .SetText(15, "Outer: 2"),
            .Create(16, "button"),
            .Append(8, 16),
            .Listen(16, "click", 5),
            .Create(17, "text"),
            .Append(16, 17),
            .SetText(17, "inner+"),
        ],
        reason="showing again rebuilds the branch: inner state reset, outer state current",
    )
    assert_equal(click(5), [.SetText(14, "Inner: 1")], reason="the new inner handler works")
    assert_equal(click(2), [.SetText(15, "Outer: 3")], reason="the new outer binding works")
