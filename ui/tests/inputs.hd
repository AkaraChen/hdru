use pkg.{
    Style,
    Command,
    Mutate,
    Ui,
    UiEvent,
    button,
    checkbox,
    column,
    dispatch,
    input,
    mount,
    on,
    reset_for_test,
    signal,
    take_commands,
    text_live,
}
use std.testing.assert_equal

fn send(handler: usize, payload: string) -> List[Command]:
    dispatch(UiEvent { handler: handler, payload: payload })
    take_commands()

fn form() -> void $ Ui:
    draft := signal("hello")
    column:
        input(draft, style=Style::empty().grow(1.0))
        on(
            "enter",
            fn(text: string) -> void $ Mutate:
                draft.set("")
            ,
        )
        text_live:
            "draft: ${draft.get()}"
        button("clear", fn(): draft.set(""))
        button("fill", fn(): draft.set("filled"))

it("input mounts with its value and listens for input"):
    reset_for_test()
    _ := mount(form)
    assert_equal(
        take_commands(),
        [
            .Create(1, "box"),
            .SetProp(1, "direction", .Text("column")),
            .Append(0, 1),
            .Create(2, "input"),
            .SetProp(2, "grow", .Number(1.0)),
            .Append(1, 2),
            .SetProp(2, "value", .Text("hello")),
            .Listen(2, "input", 1),
            .Listen(2, "enter", 2),
            .Create(3, "text"),
            .Append(1, 3),
            .SetText(3, "draft: hello"),
            .Create(4, "button"),
            .Append(1, 4),
            .SetText(4, "clear"),
            .Listen(4, "click", 3),
            .Create(5, "button"),
            .Append(1, 5),
            .SetText(5, "fill"),
            .Listen(5, "click", 4),
        ],
        reason="the mount command list",
    )

it("a keystroke updates the signal and is not echoed back"):
    reset_for_test()
    _ := mount(form)
    _ := take_commands()
    assert_equal(send(1, "hello!"), [.SetText(3, "draft: hello!")], reason="no SetProp for the typed value")
    assert_equal(send(1, "hello!"), [], reason="the same text again writes nothing")

it("a write from elsewhere reaches the field"):
    reset_for_test()
    _ := mount(form)
    _ := take_commands()
    _ := send(1, "typed")
    assert_equal(
        send(3, ""),
        [.SetProp(2, "value", .Text("")), .SetText(3, "draft: ")],
        reason="clear sends the new value to the field",
    )
    assert_equal(send(1, "x"), [.SetText(3, "draft: x")], reason="typing again is not echoed")
    assert_equal(
        send(4, ""),
        [.SetProp(2, "value", .Text("filled")), .SetText(3, "draft: filled")],
        reason="fill",
    )
    assert_equal(
        send(2, "filled"),
        [.SetProp(2, "value", .Text("")), .SetText(3, "draft: ")],
        reason="enter clears it",
    )

fn agreement() -> void $ Ui:
    agreed := signal(false)
    column:
        checkbox(agreed)
        text_live:
            if agreed.get(): "agreed" else: "not yet"
        button("reset", fn(): agreed.set(false))

it("checkbox follows change events and writes from elsewhere"):
    reset_for_test()
    _ := mount(agreement)
    commands := take_commands()
    assert_equal(commands.contains(.Create(2, "checkbox")), true, reason="a checkbox")
    assert_equal(commands.contains(.SetProp(2, "checked", .Flag(false))), true, reason="initially unchecked")
    assert_equal(commands.contains(.Listen(2, "change", 1)), true, reason="listens for change")
    assert_equal(send(1, "true"), [.SetText(3, "agreed")], reason="checked by the user, not echoed")
    assert_equal(send(2, ""), [.SetProp(2, "checked", .Flag(false)), .SetText(3, "not yet")], reason="reset")
