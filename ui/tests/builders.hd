use pkg.{
    view,
    Style,
    Command,
    UiEvent,
    button,
    column,
    dispatch,
    last_node,
    mount,
    reset_for_test,
    row,
    show,
    signal,
    take_commands,
    text,
}
use pkg.{Ui}
use std.testing.assert_equal

fn counter() -> void $ Ui:
    count := signal(+0)
    column(style=Style::empty().gap(8.0)):
        text:
            "Count: ${count.get()}"
        row:
            button(
                fn():
                    count.update(fn(n): n - 1)
                ,
            ):
                text(fn(): "-")
            button(
                fn():
                    count.update(fn(n): n + 1)
                ,
            ):
                text(fn(): "+")
            button(fn(): count.set(count.peek())):
                text(fn(): "same")

it("mounting the counter emits the tree in order"):
    reset_for_test()
    _ := mount(counter)
    let expected: List[Command] = [
        .Create(1, "box"),
        .SetProp(1, "direction", .Text("column")),
        .SetProp(1, "gap", .Number(8.0)),
        .Append(0, 1),
        .Create(2, "text"),
        .Append(1, 2),
        .SetText(2, "Count: 0"),
        .Create(3, "box"),
        .SetProp(3, "direction", .Text("row")),
        .Append(1, 3),
        .Create(4, "button"),
        .Append(3, 4),
        .Listen(4, "click", 1),
        .Create(5, "text"),
        .Append(4, 5),
        .SetText(5, "-"),
        .Create(6, "button"),
        .Append(3, 6),
        .Listen(6, "click", 2),
        .Create(7, "text"),
        .Append(6, 7),
        .SetText(7, "+"),
        .Create(8, "button"),
        .Append(3, 8),
        .Listen(8, "click", 3),
        .Create(9, "text"),
        .Append(8, 9),
        .SetText(9, "same"),
    ]
    assert_equal(take_commands(), expected, reason="the mount command list")

it("one click emits exactly one SetText and an equal text emits nothing"):
    reset_for_test()
    _ := mount(counter)
    _ := take_commands()
    dispatch(UiEvent { handler: 2, payload: "" })
    assert_equal(take_commands(), [.SetText(2, "Count: 1")], reason="plus")
    dispatch(UiEvent { handler: 1, payload: "" })
    assert_equal(take_commands(), [.SetText(2, "Count: 0")], reason="minus")
    dispatch(UiEvent { handler: 3, payload: "" })
    assert_equal(take_commands(), [], reason="same text, no command")
    dispatch(UiEvent { handler: 99, payload: "" })
    assert_equal(take_commands(), [], reason="unknown handler, no command")

it("static text and nesting append to the right parent"):
    reset_for_test()
    _ := mount:
        column:
            text(fn(): "a")
            row:
                text(fn(): "b")
            text(fn(): "c")
    assert_equal(
        take_commands(),
        [
            .Create(1, "box"),
            .SetProp(1, "direction", .Text("column")),
            .Append(0, 1),
            .Create(2, "text"),
            .Append(1, 2),
            .SetText(2, "a"),
            .Create(3, "box"),
            .SetProp(3, "direction", .Text("row")),
            .Append(1, 3),
            .Create(4, "text"),
            .Append(3, 4),
            .SetText(4, "b"),
            .Create(5, "text"),
            .Append(1, 5),
            .SetText(5, "c"),
        ],
        reason="nested parents",
    )

it("a button shows what it holds, and a click updates only that"):
    reset_for_test()
    _ := mount:
        count := signal(+0)
        button(fn(): count.update(fn(n): n + 1)):
            text:
                "${count.get()}"
    assert_equal(
        take_commands(),
        [
            .Create(1, "button"),
            .Append(0, 1),
            .Listen(1, "click", 1),
            .Create(2, "text"),
            .Append(1, 2),
            .SetText(2, "0"),
        ],
        reason="the text is the button's child",
    )
    dispatch(UiEvent { handler: 1, payload: "" })
    assert_equal(take_commands(), [.SetText(2, "1")], reason="one command, for the text")

it("a button's block can hold anything, and last_node names the button after it"):
    reset_for_test()
    seen := box([0])
    _ := mount:
        open := signal(true)
        button(fn(): open.update(fn(v): !v)):
            view:
                text(fn(): "icon")
            show(fn(): open.get()):
                text(fn(): "label")
        seen[0] = last_node()
    commands := take_commands()
    assert_equal(commands.contains(.Append(1, 2)), true, reason="a box in the button")
    assert_equal(seen[0], 1, reason="the button")
    dispatch(UiEvent { handler: 1, payload: "" })
    assert_equal(take_commands(), [.Clear(4)], reason="show works inside it")
