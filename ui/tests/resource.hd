use pkg.{
    Command,
    Resource,
    Ui,
    UiEvent,
    button,
    column,
    dispatch,
    mount,
    reset_for_test,
    resource,
    run_job,
    show,
    signal,
    take_commands,
    take_new_jobs,
    text_live,
}
use std.testing.assert_equal

fn describe(state: Resource[string, string]) -> string:
    match state:
        .Loading => "loading"
        .Ready(value) => "ready: $value"
        .Failed(error) => "failed: $error"

fn lookup!(id: i32) -> Result[string, string]:
    if id < 0: .Err("negative id $id") else: .Ok("user $id")

fn profile() -> void $ Ui:
    id := signal(+1)
    user := resource(fn(): id.get(), lookup)
    column:
        text_live:
            describe(user.get())
        button(
            "next",
            fn():
                id.update(fn(n): n + 1)
            ,
        )
        button("bad", fn(): id.set(-1))

## Runs every job registered so far, and any they register, then returns
## what they emitted: what a worker pool would do, on the test task.
fn run_pending!() -> List[Command]:
    while true:
        ids := take_new_jobs()
        if ids.is_empty():
            break
        for id in ids:
            run_job!(id)
    take_commands()

fn click(handler: usize) -> List[Command]:
    dispatch(UiEvent { handler: handler, payload: "" })
    take_commands()

it("a resource is Loading until its job runs, then Ready"):
    reset_for_test()
    _ := mount(profile)
    commands := take_commands()
    assert_equal(commands.contains(.SetText(2, "loading")), true, reason="loading at mount")
    assert_equal(run_pending!(), [.SetText(2, "ready: user 1")], reason="the loader's value landed")

it("a key change reloads, drops the stale job, and a failure lands as Failed"):
    reset_for_test()
    _ := mount(profile)
    _ := take_commands()
    assert_equal(click(1), [], reason="still loading: same text, no command")
    assert_equal(run_pending!(), [.SetText(2, "ready: user 2")], reason="only the job for key 2 ran")
    assert_equal(click(1), [.SetText(2, "loading")], reason="a new key goes back to loading")
    assert_equal(click(2), [], reason="bad key: already loading")
    assert_equal(
        run_pending!(),
        [.SetText(2, "failed: negative id -1")],
        reason="one more landing: the failure",
    )

fn gated() -> void $ Ui:
    open := signal(true)
    column:
        button(
            "toggle",
            fn():
                open.update(fn(v): !v)
            ,
        )
        show(fn(): open.get()):
            profile()

it("disposing the owner drops a queued job"):
    reset_for_test()
    _ := mount(gated)
    _ := take_commands()
    assert_equal(click(1), [.Clear(3)], reason="hidden")
    assert_equal(run_pending!(), [], reason="the branch's job never ran")
