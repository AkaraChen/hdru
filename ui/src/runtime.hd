## The program-wide UI runtime: the pending command list, the handler
## table, the job table and the id counters. `mount` builds a tree;
## `dispatch` routes one event to its handler and flushes. Everything here
## is synchronous except `run_job!`; a renderer package such as `ui-dom`
## supplies the loop that moves commands, events and jobs across a host.
use std.function.FnMut
use dep.reactive.{Mutate, NoTrack, Owner, OwnerId, SourceId, Track, WriteLog, batch, flush, new_owner, reset_graph_for_test}
use pkg.keys.{HandlerId, NodeId, Parent, Scope, Ui}
use pkg.protocol.{Command, UiEvent}

## A resource load waiting for a worker: a cold suspension that drives
## the loader and lands its result.
pub struct Job:
    pub task: Suspend[void]

struct Runtime:
    out: List[Command]
    handlers: Map[HandlerId, fn(string) -> void $ Mutate]
    next_node: usize
    next_handler: usize
    ## Jobs by id, until a worker takes one.
    jobs: Map[usize, Job]
    ## Ids registered since the loop last took them.
    unposted: List[usize]
    next_job: usize
    ## What runs once the commands queued so far have been applied.
    ready: List[fn() -> void $ Mutate]
    ## The sources the last dispatched handler wrote.
    last_writes: List[SourceId]

RUNTIME := box(
    Runtime {
        out: [],
        handlers: {},
        next_node: 1,
        next_handler: 1,
        jobs: {},
        unposted: [],
        next_job: 1,
        ready: [],
        last_writes: [],
    },
)

fn runtime() -> *mut Runtime:
    RUNTIME

## Queues one command for the next `take_commands`.
pub fn emit(command: Command) -> void:
    runtime().out.push(command)

## Makes a node id and emits its `Create`.
pub fn create_node(kind: string) -> NodeId:
    rt := runtime()
    node := rt.next_node
    rt.next_node += 1
    emit(.Create(node, kind))
    node

## Queues `callback` to run after the host has applied the commands queued so
## far (`run_ready`).
pub fn after_apply[F < 'static & FnMut() -> void $ Mutate](mut callback: F) -> void:
    erased := fn() -> void $ Mutate: callback()
    runtime().ready.push(erased)

## Runs what `after_apply` queued, in order, as one batch, and flushes. The loop
## calls this after each `apply!`; a test without a loop calls it itself.
pub fn run_ready() -> void:
    rt := runtime()
    queue := rt.ready
    rt.ready = []
    log := box(WriteLog { sources: [] })
    $.with(Mutate=log):
        batch(
            fn() -> void $ Mutate:
                for callback in queue:
                    callback()
            ,
        )
    flush()

## Registers a handler and returns its id.
pub fn register_handler[F < 'static & FnMut(string) -> void $ Mutate](mut handler: F) -> HandlerId:
    rt := runtime()
    id := rt.next_handler
    rt.next_handler += 1
    erased := fn(payload: string) -> void $ Mutate: handler(payload)
    rt.handlers[id] = erased
    id

pub fn drop_handler(id: HandlerId) -> void:
    _ := runtime().handlers.remove(id)

## Registers a job and returns its id. The loop takes it with
## `take_new_jobs` and hands it to a worker.
pub fn register_job(task: Suspend[void]) -> usize:
    rt := runtime()
    id := rt.next_job
    rt.next_job += 1
    rt.jobs[id] = Job { task: task }
    rt.unposted.push(id)
    id

## Forgets a job a worker has not taken yet; a cold suspension needs no
## cleanup. A job already running completes and its result is dropped by
## the resource's generation check.
pub fn drop_job(id: usize) -> void:
    _ := runtime().jobs.remove(id)

## Drains and returns the queued commands.
pub fn take_commands() -> List[Command]:
    rt := runtime()
    commands := rt.out
    rt.out = []
    commands

## Drains and returns the ids of the jobs registered since the last call,
## for the loop to hand to its workers.
pub fn take_new_jobs() -> List[usize]:
    rt := runtime()
    ids := rt.unposted
    rt.unposted = []
    ids

## Runs one registered job on the current task: drives the loader and
## lands its result. A job a `drop_job` removed is skipped.
pub fn run_job!(id: usize) -> void:
    found := runtime().jobs.remove(id)
    match found:
        .Some(job) =>
            let mut task = job.task
            task!()
        .None => pass

## Builds `root` under a fresh owner, appending to node 0, and flushes.
## Returns the owner so the tree can be disposed. A root that needs other
## providers, say `$ Ui + Clock` to capture a clock for a loader, names
## them in its row and `mount` requires them too. So a context key that
## no ancestor provides is a compile error, here a component that needs a
## `Provided[string]` called from one whose row is `$ Ui`:
##
## ```hd
## use pkg.{Provided, Ui, column, text, use_given}
## fn title() -> void $ Ui + Provided[string]:
##     text(use_given::[string]())
## fn app() -> void $ Ui:
##     column:  # error: missing-requirement
##         title()
## ```
pub fn mount[$ R](root: fn() -> void $ Ui + R) -> OwnerId $ R:
    owner := new_owner(.None)
    scope := box(Scope { owner: owner, parent: 0 })
    $.with(Owner=scope, Parent=scope, Track=box(NoTrack {})):
        root()
    flush()
    owner

## Runs the handler of `event` inside a batch, then flushes. The sources
## the handler wrote are kept for `last_writes`.
pub fn dispatch(event: UiEvent) -> void:
    found := runtime().handlers.get(event.handler)
    match found:
        .Some(handler) =>
            payload := event.payload
            log := box(WriteLog { sources: [] })
            $.with(Mutate=log):
                batch(fn() -> void $ Mutate: handler(payload))
            runtime().last_writes = log.sources
        .None => runtime().last_writes = []
    flush()

## The sources the handler of the last `dispatch` wrote, in the order it
## first wrote each, so a tool can show "this click wrote `count`" by
## comparing with `count.id()`. Writes by effects the flush ran are not
## the handler's and are not listed.
pub fn last_writes() -> List[SourceId]:
    runtime().last_writes

## Resets ids, clears the queues and the handler table, and empties the
## reactive graph. For tests that assert exact command lists.
pub fn reset_for_test() -> void:
    rt := runtime()
    rt.out = []
    rt.handlers = {}
    rt.next_node = 1
    rt.next_handler = 1
    rt.jobs = {}
    rt.unposted = []
    rt.next_job = 1
    rt.ready = []
    rt.last_writes = []
    reset_graph_for_test()
