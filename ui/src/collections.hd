## Keyed collections: `for_each` renders one row per item and keeps a row
## alive across updates as long as its key is present.
use std.function.Fn
use std.format.{Debug, debug}
use std.hash.Hash
use dep.reactive.{Mutate, NoTrack, Owner, OwnerId, ReadSignal, Reactive, Signal, Track, dispose, new_owner, run_effect, signal}
use pkg.keys.{NodeId, Parent, Scope, Ui}
use pkg.runtime.{create_node, emit}

struct Row[T < 'static]:
    owner: OwnerId
    node: NodeId
    item: Signal[T]

struct Rows[T < 'static, K < 'static & Eq & Hash]:
    rows: Map[K, Row[T]]
    order: List[K]

## Renders `render` once per item of `items`, keyed by `key`. When the
## list changes: a row whose key stays receives the new item through its
## signal, written only when the item differs, so an unrelated change to
## the list reruns nothing inside that row; a new key mounts a row, a
## missing key disposes one, and order changes emit `MoveBefore` only where
## the order differs. Each row renders into its own fragment node under one
## list node. Two items with one key are a panic that names the key.
pub fn for_each[
    T < 'static & Eq,
    K < 'static & Eq & Hash & Debug,
    KF < 'static & Fn(T) -> K,
    R < 'static & Fn(ReadSignal[T]) -> void $ Ui,
](items: ReadSignal[List[T]], key: KF, render: R) -> void $ Ui:
    owner := $.use(Owner).owner()
    parent := $.use(Parent).parent()
    fragment := create_node("fragment")
    emit(.Append(parent, fragment))
    state := box(Rows::[T, K] { rows: {}, order: [] })
    run := fn() -> bool $ Reactive:
        list := items.get()
        let mut new_keys: List[K] = []
        for item in list:
            k := key(item)
            if new_keys.contains(k):
                panic("ui: for_each: duplicate key ${debug(k)}")
            new_keys.push(k)
        old_order := state.order
        let mut current: List[K] = []
        for k in old_order:
            if new_keys.contains(k):
                current.push(k)
            else:
                row := state.rows[k]
                dispose(row.owner)
                emit(.Remove(row.node))
                _ := state.rows.remove(k)
        for item in list:
            k := key(item)
            if state.rows.contains_key(k):
                state.rows[k].item.set_if_changed(item)
            else:
                child := new_owner(.Some(owner))
                item_signal := signal(item)
                node := create_node("fragment")
                emit(.Append(fragment, node))
                scope := box(Scope { owner: child, parent: node })
                $.with(Owner=scope, Parent=scope, Track=box(NoTrack {})):
                    render(item_signal.read())
                state.rows[k] = Row { owner: child, node: node, item: item_signal }
                current.push(k)
        let index = 0
        while index < new_keys.len():
            wanted := new_keys[index]
            if current[index] != wanted:
                match current.index_of(wanted):
                    .Some(from) => _ := current.remove_at(from)
                    .None => pass
                current.insert(index, wanted)
                emit(
                    .MoveBefore(
                        fragment,
                        state.rows[wanted].node,
                        .Some(state.rows[current[index + 1]].node),
                    ),
                )
            index += 1
        state.order = current
        false
    _ := run_effect(owner, run)
