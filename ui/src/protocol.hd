## The renderer protocol: the commands the runtime sends and the events it
## receives. A renderer package (`ui-dom`) declares the host trait that
## carries them.
use pkg.keys.{HandlerId, NodeId}

@derive(Eq, Debug)
pub enum DomCommand:
    ## Makes a node of `kind`: "div", "button" or "text".
    Create(node: NodeId, kind: string)
    ## Appends `child` as the last child of `parent`.
    Append(parent: NodeId, child: NodeId)
    ## Moves `child` under `parent`, before `before`, or last when `.None`.
    MoveBefore(parent: NodeId, child: NodeId, before: NodeId?)
    SetText(node: NodeId, text: string)
    SetAttr(node: NodeId, name: string, value: string)
    ## Reports `event` on `node` as `UiEvent { handler, payload }`.
    Listen(node: NodeId, event: string, handler: HandlerId)
    ## Removes `node` and its subtree.
    Remove(node: NodeId)
    ## Removes every child of `node`, keeping the node.
    Clear(node: NodeId)

@derive(Eq, Debug)
pub struct UiEvent:
    pub handler: HandlerId
    ## The input value for an input event; empty for a click.
    pub payload: string
