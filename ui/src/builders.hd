## Node builders. Each reads `$.use(Owner)` and `$.use(Parent)` into locals
## and never captures them; a container runs its block under a fresh
## `Parent` and `Target` that name the new node. Each takes `style: Style =
## Style::empty()` and emits one `SetProp` per set field after `Create`,
## then attaches the node.
use std.function.{Fn, FnMut}
use dep.reactive.{Mutate, NoTrack, Owner, OwnerId, Reactive, Track, cleanup_on, dispose, new_owner, run_effect}
use pkg.keys.{NodeId, Parent, Scope, Target, Ui}
use pkg.protocol.PropValue
use pkg.runtime.{after_apply, create_node, drop_handler, emit, register_handler}
use pkg.style.{Direction, Style, diff, lower}

struct Last[T]:
    ## What was last written; none until the first run.
    value: T?

struct Shown:
    child: OwnerId?

struct LastStyle:
    style: Style

## Emits one `SetProp` for each field `style` sets, in key order.
pub fn apply_style(node: NodeId, style: Style) -> void:
    for (key, value) in lower(style):
        emit(.SetProp(node, key, value))

## Makes a node of `kind` with `style`, appended to the current parent.
pub fn styled_node(kind: string, style: Style) -> NodeId $ Ui:
    parent := $.use(Parent).parent()
    node := create_node(kind)
    apply_style(node, style)
    emit(.Append(parent, node))
    node

## A box: a flex container, a column unless `style` says otherwise, whose
## block runs now under the caller's row. `column` and `row` are views
## with the direction set.
pub fn view[$R](style: Style = Style::empty(), children: fn() -> void $ Ui + Target + R) -> void $ Ui + R:
    container("box", style, children)

## A node of `kind` holding what its block builds, for a renderer package's own
## kinds of container, as `ui-dom`'s `link`. Its block can address it.
pub fn container[$R](kind: string, style: Style, children: fn() -> void $ Ui + Target + R) -> void $ Ui + R:
    owner := $.use(Owner).owner()
    node := styled_node(kind, style)
    scope := box(Scope { owner: owner, parent: node })
    $.with(Parent=scope, Target=scope):
        children()

## A vertical box. The block runs now, under the caller's row: any key the
## component names besides `Ui`, say `Theme`, reaches every block nested
## inside it, and a key the component does not name is a compile error. So
## an eager read in a component whose row is `$ Ui` fails:
##
## ```hd
## use pkg.{Ui, column, signal, text}
## fn view() -> void $ Ui:
##     count := signal(+1)
##     column:  # error: missing-requirement
##         n := count.get()
##         text(fn(): "$n")
## ```
##
## `column(style=Style::empty().gap(8.0).padding(12.0)):` styles it; name
## the argument, since the block is the last parameter.
pub fn column[$R](style: Style = Style::empty(), children: fn() -> void $ Ui + Target + R) -> void $ Ui + R:
    view(Style { ...style, direction: .Some(.Column) }, children)

## A horizontal box; its block runs under the caller's row, as `column`'s
## does.
pub fn row[$R](style: Style = Style::empty(), children: fn() -> void $ Ui + Target + R) -> void $ Ui + R:
    view(Style { ...style, direction: .Some(.Row) }, children)

## Restyles the block's node: inside a `column:`, `row:` or `view:`
## block, the block of `style_live` returns a `Style` that follows the
## signals it reads. Each run emits a `SetProp` only for the keys that
## changed since the last run, and `Unset` for a key that went unset; an
## equal style emits nothing. The first run is compared with an empty
## style, so the keys a live style sets are its own: give a key either a
## static or a live value, not both.
##
## ```hd
## use pkg.{Style, Ui, column, signal, style_live, text}
## fn faded() -> void $ Ui:
##     dim := signal(false)
##     column:
##         style_live:
##             Style::empty().opacity(if dim.get(): 0.5 else: 1.0)
##         text(fn(): "hello")
## ```
pub fn style_live[F < 'static & Fn() -> Style $ Track](compute: F) -> void $ Owner + Target:
    owner := $.use(Owner).owner()
    node := $.use(Target).target()
    last := box(LastStyle { style: Style::empty() })
    run := fn() -> bool $ Reactive:
        next := compute()
        for (key, value) in diff(last.style, next):
            emit(.SetProp(node, key, value))
        last.style = next
        false
    _ := run_effect(owner, run)

## Text. The block runs now and again whenever a signal it reads changes, and
## equal text emits nothing, so text that reads no signal is only written once.
## It takes no `style`, so that the block can be trailing; style text through
## its container, as both renderers inherit `color` and `font_weight`.
pub fn text[F < 'static & Fn() -> string $ Track](content: F) -> void $ Ui:
    owner := $.use(Owner).owner()
    parent := $.use(Parent).parent()
    node := create_node("text")
    emit(.Append(parent, node))
    follow(owner, content, fn(next: string) -> void: emit(.SetText(node, next)))

# Runs `compute` now and whenever a signal it read changes, and calls
# `write` with its value the first time and each time it differs.
fn follow[T < 'static & Eq, F < 'static & Fn() -> T $ Track, W < 'static & Fn(T) -> void](
    owner: OwnerId,
    compute: F,
    write: W,
) -> void:
    last := box(Last::[T] { value: .None })
    run := fn() -> bool $ Reactive:
        next := compute()
        if last.value != .Some(next):
            last.value = .Some(next)
            write(next)
        false
    _ := run_effect(owner, run)

## A button: a container that sends `click` to `on_click`. The handler may write
## signals but not read them tracked; use `peek` or `update`. Its block runs
## now, under the caller's row. `style` is named:
## `button(save, style=primary): text(fn(): "save")`.
pub fn button[$R, F < 'static & FnMut() -> void $ Mutate](
    mut on_click: F,
    style: Style = Style::empty(),
    children: fn() -> void $ Ui + Target + R,
) -> void $ Ui + R:
    owner := $.use(Owner).owner()
    node := styled_node("button", style)
    listen(owner, node, "click", fn(payload: string) -> void $ Mutate: on_click())
    scope := box(Scope { owner: owner, parent: node })
    $.with(Parent=scope, Target=scope):
        children()

## Registers `handler` for `event` on `node` and drops it with `owner`.
pub fn listen[F < 'static & FnMut(string) -> void $ Mutate](
    owner: OwnerId,
    node: NodeId,
    event: string,
    mut handler: F,
) -> void:
    id := register_handler(fn(payload: string) -> void $ Mutate: handler(payload))
    emit(.Listen(node, event, id))
    cleanup_on(owner, fn() -> void: drop_handler(id))

## Mounts `branch` while `when` is true and disposes it when it turns
## false. The branch keeps its place: it renders into a "fragment" node,
## which lays its children out as if they were its parent's, and which
## stays in the parent.
pub fn show[C < 'static & Fn() -> bool $ Track, F < 'static & Fn() -> void $ Ui](
    when: C,
    branch: F,
) -> void $ Ui:
    owner := $.use(Owner).owner()
    parent := $.use(Parent).parent()
    fragment := create_node("fragment")
    emit(.Append(parent, fragment))
    shown := box(Shown { child: .None })
    run := fn() -> bool $ Reactive:
        visible := when()
        match shown.child:
            .Some(child) =>
                if !visible:
                    dispose(child)
                    emit(.Clear(fragment))
                    shown.child = .None
            .None =>
                if visible:
                    child := new_owner(.Some(owner))
                    scope := box(Scope { owner: child, parent: fragment })
                    $.with(Owner=scope, Parent=scope, Track=box(NoTrack {})):
                        branch()
                    shown.child = .Some(child)
        false
    _ := run_effect(owner, run)

## A property of the block's node by key, following the signals `compute` reads:
## one `SetProp` per change and none for an equal value. How a renderer package
## adds words the portable vocabulary lacks, as `ui-dom`'s `attr` does; an app
## sets properties through `Style`.
pub fn prop[F < 'static & Fn() -> PropValue $ Track](key: string, compute: F) -> void $ Owner + Target:
    owner := $.use(Owner).owner()
    node := $.use(Target).target()
    follow(owner, compute, fn(next: PropValue) -> void: emit(.SetProp(node, key, next)))

struct Alive:
    yes: bool

## Calls `callback` with the block's node once the host has applied it, so that
## host code handed the id can find it: the ref. A renderer's nodes are opaque to
## `ui`, and what an id means is between the app and its host. It runs at most once,
## and not at all if the node's owner is disposed first.
pub fn on_ready[F < 'static & FnMut(NodeId) -> void $ Mutate](mut callback: F) -> void $ Owner + Target:
    node := $.use(Target).target()
    alive := box(Alive { yes: true })
    cleanup_on($.use(Owner).owner(), fn() -> void: alive.yes = false)
    after_apply(
        fn() -> void $ Mutate:
            if alive.yes:
                callback(node)
        ,
    )
